---
import BaseLayout from "../layouts/BaseLayout.astro";
import CounterIsland from "../components/astro-demo/CounterIsland.jsx";
import BrowserFetch from "../components/astro-demo/BrowserFetch.jsx";
import SSRExample from "../components/astro-demo/SSRExample.astro";
import "../styles/astro-demo.css";

const staticCode = [
  "---",
  'const heading = "Built as HTML";',
  "---",
  "<h2>{heading}</h2>",
  "<p>This markup is rendered by Astro.</p>",
].join("\n");

const fetchCode = [
  "useEffect(() => {",
  '  fetch("https://jsonplaceholder.typicode.com/posts/1")',
  "    .then((response) => response.json())",
  "    .then(setPost);",
  "}, []);",
].join("\n");

const islandsCode = [
  '<CounterIsland title="Page load" client:load />',
  '<CounterIsland title="When visible" client:visible />',
  '<CounterIsland title="When idle" client:idle />',
  '<CounterIsland title="Client only" client:only="react" />',
].join("\n");
---

<BaseLayout
  title="Astro demo"
  description="A small presentation demo of Astro's server-first architecture and interactive islands."
  noindex
>
  <div class="astro-demo">
    <header class="astro-demo__hero">
      <p class="astro-demo__eyebrow">presentation demo <span>/</span> astro</p>
      <h1 class="astro-demo__title">
        HTML first<span>.</span><br />
        interactive when needed.
      </h1>
      <p class="astro-demo__intro">
        A quick look at Astro rendering modes and the different ways to hydrate
        an island.
      </p>
    </header>

    <section class="astro-demo__section" aria-labelledby="static-title">
      <div class="astro-demo__section-heading">
        <span class="astro-demo__number">01</span>
        <div>
          <p class="astro-demo__label">Rendering mode</p>
          <h2 id="static-title">Static generation</h2>
          <p class="astro-demo__description">
            Astro turns the component into HTML during the build.
          </p>
        </div>
      </div>

      <div class="astro-demo__example-grid">
        <div class="astro-demo__code-panel">
          <div class="astro-demo__code-heading">
            <span>page.astro</span><span>Astro</span>
          </div>
          <pre><code>{staticCode}</code></pre>
        </div>
        <div class="astro-demo__output">
          <span class="astro-demo__output-label">Rendered HTML</span>
          <h3>Built as HTML</h3>
          <p>This markup is rendered by Astro.</p>
        </div>
      </div>
    </section>

    <section class="astro-demo__section" aria-labelledby="ssr-title">
      <div class="astro-demo__section-heading">
        <span class="astro-demo__number">02</span>
        <div>
          <p class="astro-demo__label">Rendering mode</p>
          <h2 id="ssr-title">Server-side rendering</h2>
          <p class="astro-demo__description">
            Render the page for each request and use fresh server values.
          </p>
        </div>
      </div>

      <SSRExample />
    </section>

    <section class="astro-demo__section" aria-labelledby="fetch-title">
      <div class="astro-demo__section-heading">
        <span class="astro-demo__number">03</span>
        <div>
          <p class="astro-demo__label">Rendering mode</p>
          <h2 id="fetch-title">Client-side data</h2>
          <p class="astro-demo__description">
            Fetch data in the browser after the component hydrates.
          </p>
        </div>
      </div>

      <div class="astro-demo__example-grid">
        <div class="astro-demo__code-panel">
          <div class="astro-demo__code-heading">
            <span>BrowserFetch.jsx</span><span>React</span>
          </div>
          <pre><code>{fetchCode}</code></pre>
        </div>
        <BrowserFetch client:load />
      </div>
    </section>

    <section class="astro-demo__section" aria-labelledby="islands-title">
      <div class="astro-demo__section-heading">
        <span class="astro-demo__number">04</span>
        <div>
          <p class="astro-demo__label">Astro islands</p>
          <h2 id="islands-title">Choose when to hydrate.</h2>
          <p class="astro-demo__description">
            Each counter is its own interactive island. Try the different
            hydration timings.
          </p>
        </div>
      </div>

      <div class="astro-demo__islands">
        <div class="astro-demo__code-panel astro-demo__island-code">
          <div class="astro-demo__code-heading">
            <span>page.astro</span><span>Hydration directives</span>
          </div>
          <pre><code>{islandsCode}</code></pre>
        </div>

        <div class="astro-demo__counter-grid">
          <!-- Hydrate on page load -->
          <CounterIsland title="Page load" client:load />
          <!-- Hydrate when visible -->
          <CounterIsland title="When visible" client:visible />
          <!-- Hydrate when idle -->
          <CounterIsland title="When idle" client:idle />
          <!-- Render in the browser only -->
          <CounterIsland title="Client only" client:only="react" />
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
